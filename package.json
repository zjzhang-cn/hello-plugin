{
  "name": "dsh-hello-plugin",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build": "tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.client.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}